# Neon Postgres (pooler connection)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Secret required in the X-Webhook-Secret header for POST /api/webhooks/affiliate
WEBHOOK_SECRET="change-me-webhook-secret"

# Share of the network commission credited to the user's wallet as cashback (0..1)
CASHBACK_RATE="0.7"

# Minimum withdrawal amount in VND
MIN_WITHDRAWAL="50000"

# Affiliate link provider: "mock" | "accesstrade" | "shopee" | "tiktok"
# Global default. Can be overridden per platform below.
AFFILIATE_PROVIDER="mock"

# Optional per-platform overrides (fall back to AFFILIATE_PROVIDER if unset).
# Set AFFILIATE_PROVIDER_TIKTOK="tiktok" to use the real TikTok Shop API.
AFFILIATE_PROVIDER_TIKTOK=""
AFFILIATE_PROVIDER_SHOPEE=""

# Public base URL used to build short affiliate links (no trailing slash)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- TikTok Shop Affiliate Creator API ---
# From Partner Center > App & Service > your app > Credentials.
# For sandbox testing, use the SANDBOX app's key/secret here.
TIKTOK_APP_KEY=""
TIKTOK_APP_SECRET=""
# Optional host overrides for sandbox / test-shop. Leave unset for production.
# Only set these if the sandbox environment uses a different host than prod.
TIKTOK_API_BASE=""
TIKTOK_AUTH_BASE=""
TIKTOK_CREATOR_AUTH_URL=""

# --- Shopee Affiliate Open API ---
# From the Shopee Affiliate Open Platform (open-api.affiliate.shopee.vn).
# Single app credential (no per-creator OAuth). Set AFFILIATE_PROVIDER_SHOPEE
# ="shopee" above to use the real API. Leave empty to keep Shopee on mock links.
SHOPEE_APP_ID=""
SHOPEE_APP_SECRET=""
# Optional host override (defaults to https://open-api.affiliate.shopee.vn).
SHOPEE_API_BASE=""

# --- Better Auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated emails auto-granted the "admin" role on sign-up.
ADMIN_EMAILS=""

# Secret required in the x-cron-secret header for GET /api/cron/sync-orders
CRON_SECRET="change-me-cron-secret"

# --- Email notifications (Resend). If unset, emails are skipped (no-op). ---
RESEND_API_KEY=""
EMAIL_FROM="Win-Win Back <no-reply@yourdomain>"
